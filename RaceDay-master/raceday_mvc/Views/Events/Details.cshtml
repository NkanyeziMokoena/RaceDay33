@model EventVm
@{ViewData["Title"]=Model.Name;var cats=(List<CategoryVm>)ViewBag.Categories;}
<a asp-action="Index">← All events</a><h1>@Model.Name</h1><p>@Model.Description</p><p><b>@Model.EventDate.ToString("dd MMMM yyyy")</b> · @Model.Location · @Model.EventType</p><h2>Categories</h2><div class="cards">@foreach(var c in cats){<article class="card"><h3>@c.Name</h3><p>@c.DistanceKm km</p><p>Maximum participants: @c.MaxParticipants</p>@if(Context.Session.GetString("Role")=="Participant"){<form asp-action="Enrol" method="post"><input type="hidden" name="categoryId" value="@c.CategoryId"/><button class="btn">Enrol now</button></form>}<a asp-controller="Results" asp-action="Leaderboard" asp-route-categoryId="@c.CategoryId">Leaderboard</a></article>}@if(!cats.Any()){<p>No categories have been added yet.</p>}</div>
