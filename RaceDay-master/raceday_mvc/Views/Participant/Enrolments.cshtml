@model List<EnrolmentVm>
@{ViewData["Title"]="My Enrolments";}<h1>My enrolments</h1><table><thead><tr><th>Event</th><th>Category</th><th>Bib number</th><th>Date registered</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.EventName</td><td>@e.CategoryName</td><td>@e.BibNumber</td><td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td><td>@e.Status</td><td><form asp-action="Cancel" method="post"><input type="hidden" name="id" value="@e.EnrolmentId"/><button class="danger">Cancel</button></form></td></tr>}</tbody></table>@if(!Model.Any()){<p>You have not enrolled in an event yet. <a asp-controller="Events" asp-action="Index">Browse events</a>.</p>}
