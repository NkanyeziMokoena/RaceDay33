@model List<ResultVm>
@{ViewData["Title"]="My Results";}<h1>My race results</h1><table><thead><tr><th>Participant</th><th>Bib</th><th>Finish time</th><th>Position</th><th>Status</th></tr></thead><tbody>@foreach(var r in Model){<tr><td>@r.ParticipantName</td><td>@r.BibNumber</td><td>@(r.FinishTime?.ToString()??"Pending")</td><td>@(r.Position?.ToString()??"—")</td><td>@r.Status</td></tr>}</tbody></table>@if(!Model.Any()){<p>Your results will appear here once recorded.</p>}
