@model List<EnrolmentVm>
@{ViewData["Title"]="Category enrolments";}<h1>Category enrolments</h1><table><thead><tr><th>Participant</th><th>Bib</th><th>Status</th><th>Record result</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.ParticipantName</td><td>@e.BibNumber</td><td>@e.Status</td><td><form asp-action="RecordResult" method="post" class="inline"><input type="hidden" name="enrolmentId" value="@e.EnrolmentId"/><input type="hidden" name="categoryId" value="@ViewBag.CategoryId"/><input name="finishTime" type="time" step="1" required/><input name="position" type="number" min="1" placeholder="Position" required/><button class="btn small">Save</button></form></td></tr>}</tbody></table>@if(!Model.Any()){<p>No participants have enrolled in this category yet.</p>}
