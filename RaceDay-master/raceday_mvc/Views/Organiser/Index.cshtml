@model List<EventVm>
@{ViewData["Title"]="Organiser dashboard";}<h1>Organiser dashboard</h1><p>Manage your events and race categories.</p><a class="btn" asp-action="CreateEvent">Create event</a><div class="cards">@foreach(var e in Model){<article class="card"><h3>@e.Name</h3><p>@e.EventDate.ToString("dd MMM yyyy") · @e.Location</p><a asp-action="EditEvent" asp-route-id="@e.EventId">Edit event</a> · <a asp-action="Categories" asp-route-id="@e.EventId">Manage categories & enrolments →</a><form asp-action="DeleteEvent" method="post" class="inline"><input type="hidden" name="id" value="@e.EventId"/><button class="danger">Delete event</button></form></article>}</div>
