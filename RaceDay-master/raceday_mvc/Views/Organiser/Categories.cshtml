@model List<CategoryVm>
@{ViewData["Title"]="Manage categories";var ev=(EventVm?)ViewBag.Event;}<h1>Categories: @ev?.Name</h1><div class="form-card"><h2>Add category</h2><form asp-action="CreateCategory" method="post"><input type="hidden" name="eventId" value="@ViewBag.EventId"/><label>Category name</label><input name="name" required/><label>Distance (km)</label><input name="distanceKm" type="number" step="0.01" min="0.1" required/><label>Maximum participants</label><input name="maxParticipants" type="number" min="1" value="100" required/><button class="btn">Add category</button></form></div><h2>Existing categories</h2><div class="cards">@foreach(var c in Model){<article class="card"><h3>@c.Name</h3><p>@c.DistanceKm km · Capacity @c.MaxParticipants</p><a asp-action="Enrolments" asp-route-categoryId="@c.CategoryId">View enrolments / record results →</a></article>}</div>
