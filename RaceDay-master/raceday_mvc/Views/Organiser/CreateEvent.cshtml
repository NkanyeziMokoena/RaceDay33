@model EventVm
@{ViewData["Title"]="Create event";}<div class="form-card"><h1>Create event</h1><form method="post"><div asp-validation-summary="All" class="error"></div><label asp-for="Name"></label><input asp-for="Name"/><label asp-for="Description"></label><textarea asp-for="Description"></textarea><label asp-for="EventDate">Event date</label><input asp-for="EventDate" type="date"/><label asp-for="Location"></label><input asp-for="Location"/><label asp-for="EventType"></label><select asp-for="EventType"><option>Run</option><option>Walk</option><option>Cycle</option></select><label asp-for="DistanceKm">Distance (km, optional)</label><input asp-for="DistanceKm" type="number" step="0.01"/><button class="btn">Save event</button></form></div>
