<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - RaceDay</title><link rel="stylesheet" href="~/css/site.css"/></head><body><header><a class="brand" asp-controller="Home" asp-action="Index">🏁 RaceDay</a><nav><a asp-controller="Events" asp-action="Index">Events</a>@if(Context.Session.GetString("Role")=="Participant"){<a asp-controller="Participant" asp-action="Enrolments">My Enrolments</a><a asp-controller="Participant" asp-action="Results">My Results</a>}@if(Context.Session.GetString("Role")=="Organiser"){<a asp-controller="Organiser" asp-action="Index">Organiser</a>}@if(Context.Session.GetString("Role")!=null){<a asp-controller="Profile" asp-action="Index">My profile</a><span class="welcome">@Context.Session.GetString("UserName")</span><form asp-controller="Account" asp-action="Logout" method="post"><button class="linkbutton">Sign out</button></form>}else{<a asp-controller="Account" asp-action="Login">Sign in</a><a asp-controller="Account" asp-action="Register">Register</a>}</nav></header><main>@if(TempData["Message"]!=null){<div class="alert">@TempData["Message"]</div>}@if(TempData["Error"]!=null){<div class="error">@TempData["Error"]</div>}@RenderBody()</main><footer>RaceDay Event Management System</footer>@await RenderSectionAsync("Scripts",required:false)</body></html>
